# Fonte de dados do front-end.
#   api   -> ApiSource, FastAPI em src/backend (padrão do projeto; com
#            MODEL_MODE=real o back-end responde com os modelos treinados)
#   local -> LocalMockSource, roda inteiramente no navegador, sem back-end e
#            sem login (demo offline das Fases 0 e 1)
VITE_DATA_SOURCE=api

# Base URL da API (só usada em VITE_DATA_SOURCE=api). "" = mesma origem.
VITE_API_BASE_URL=http://localhost:8000
