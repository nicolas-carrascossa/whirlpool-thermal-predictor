# Fonte de dados do front-end: sempre `api` -> ApiSource, FastAPI em src/backend,
# que responde com os modelos treinados (MODEL_MODE=real, padrão do back-end).
# `local` (LocalMockSource, dados sintéticos) só é aceito pelos testes.
VITE_DATA_SOURCE=api

# Base URL da API. "" = mesma origem.
VITE_API_BASE_URL=http://localhost:8000
