# Copie para `src/backend/.env` e ajuste. Nenhum destes valores é secreto em
# desenvolvimento; em produção troque JWT_SECRET por um valor aleatório longo.

# --- autenticação ---------------------------------------------------------
# Segredo de assinatura dos tokens JWT (mínimo recomendado: 32 bytes).
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-bytes
# Validade do token, em minutos (480 = 8 h, uma jornada de trabalho).
JWT_EXPIRES_MIN=480

# --- preditor -------------------------------------------------------------
# mock = gerador determinístico da Fase 2; real = modelo treinado (Fase 3).
MODEL_MODE=mock

# --- dados ----------------------------------------------------------------
# Pasta com sensor_registry.json, sensor_stats.json, variable_options.json e
# model_manifest.json. Padrão: src/backend/data (a API é dona destes dados).
DATA_DIR=./data

# Arquivo SQLite (usuários + access_log). Caminho relativo a src/backend/.
DB_PATH=./thermal.db

# --- HTTP -----------------------------------------------------------------
# Origens liberadas no CORS, separadas por vírgula (dev do Vite e preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- usuários semeados (criados automaticamente na primeira execução) ------
# engenheiro / thermal2026  -> perfil engineer
# admin      / admin2026    -> perfil admin
