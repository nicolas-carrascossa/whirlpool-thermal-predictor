{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inteli.whirlpool/thermal-predictor/contracts/api_v1.schema.json",
  "title": "Thermal Predictor — contrato da API v1",
  "description": "Gerado por npm run contract:schema a partir de src/frontend/src/contract/v1.ts. Não editar à mão.",
  "oneOf": [
    {
      "$ref": "#/$defs/PredictionRequest"
    },
    {
      "$ref": "#/$defs/PredictionResponse"
    },
    {
      "$ref": "#/$defs/Metadata"
    }
  ],
  "$defs": {
    "Architecture": {
      "description": "Arquitetura de produto. Hoje só BR possui dados de treino.",
      "enum": [
        "BR",
        "MX"
      ],
      "type": "string"
    },
    "ArchitectureMeta": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/Architecture"
        },
        "label_pt": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "available",
        "label_pt"
      ],
      "type": "object"
    },
    "KeyAreaMeta": {
      "additionalProperties": false,
      "properties": {
        "label_pt": {
          "type": "string"
        },
        "n_sensors": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "label_pt",
        "n_sensors"
      ],
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "architectures": {
          "items": {
            "$ref": "#/$defs/ArchitectureMeta"
          },
          "type": "array"
        },
        "contract_version": {
          "type": "string"
        },
        "key_areas": {
          "items": {
            "$ref": "#/$defs/KeyAreaMeta"
          },
          "type": "array"
        },
        "reference_config": {
          "$ref": "#/$defs/StoveConfig",
          "description": "Configuração real do dataset, usada como preset inicial da demo."
        },
        "sensors": {
          "items": {
            "$ref": "#/$defs/SensorMeta"
          },
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableMeta"
          },
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "architectures",
        "variables",
        "sensors",
        "key_areas",
        "reference_config"
      ],
      "type": "object"
    },
    "PredictionRequest": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "config": {
          "$ref": "#/$defs/StoveConfig"
        },
        "targets": {
          "$ref": "#/$defs/PredictionTargets"
        }
      },
      "required": [
        "architecture",
        "config"
      ],
      "type": "object"
    },
    "PredictionResponse": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "architecture_available": {
          "description": "`false` quando não há modelo treinado para a arquitetura pedida.",
          "type": "boolean"
        },
        "generated_at": {
          "description": "Timestamp ISO-8601 da geração.",
          "type": "string"
        },
        "ignored_fields": {
          "description": "Campos da config recebidos e deliberadamente ignorados pelo modelo.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model_version": {
          "description": "Versão do preditor que gerou a resposta (ex.: \"mock-0.1.0\").",
          "type": "string"
        },
        "predictions": {
          "description": "Vazio quando `architecture_available` é `false`.",
          "items": {
            "$ref": "#/$defs/SensorPrediction"
          },
          "type": "array"
        },
        "request_id": {
          "description": "Identificador determinístico da consulta (mesma request → mesmo id).",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "model_version",
        "architecture",
        "architecture_available",
        "ignored_fields",
        "predictions",
        "generated_at"
      ],
      "type": "object"
    },
    "PredictionTargets": {
      "additionalProperties": false,
      "description": "Recorte da consulta. Ambos vazios/ausentes = todos os 77 sensores.",
      "properties": {
        "key_areas": {
          "description": "Nomes de `key_area` (ex.: \"IPC Comp\").",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sensors": {
          "description": "Números de termopar (`tc_number`).",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reliability": {
      "description": "Confiabilidade da estimativa, por distância de Hamming entre a configuração consultada e as combinações presentes no conjunto de treino, considerando apenas as 5 variáveis usadas pelo modelo.\n- `interpolation`: combinação existe no treino (distância 0).\n- `moderate_extrapolation`: exatamente 1 variável diferente.\n- `out_of_domain`: 2 ou mais variáveis diferentes.",
      "enum": [
        "interpolation",
        "moderate_extrapolation",
        "out_of_domain"
      ],
      "type": "string"
    },
    "SensorMeta": {
      "additionalProperties": false,
      "properties": {
        "active_limit_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "is_monitor": {
          "type": "boolean"
        },
        "key_area": {
          "type": "string"
        },
        "monitor_reference_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "tc_name": {
          "type": "string"
        },
        "tc_number": {
          "type": "number"
        }
      },
      "required": [
        "tc_number",
        "tc_name",
        "key_area",
        "active_limit_c",
        "is_monitor",
        "monitor_reference_c"
      ],
      "type": "object"
    },
    "SensorPrediction": {
      "additionalProperties": false,
      "properties": {
        "active_limit_c": {
          "description": "Limite normativo do componente, em °C. `null` para sensores de monitoramento.",
          "type": [
            "number",
            "null"
          ]
        },
        "error_margin_c": {
          "description": "Margem de erro absoluta, em °C (± temp_c).",
          "type": "number"
        },
        "error_margin_pct": {
          "description": "Margem de erro relativa, em % de `temp_c`.",
          "type": "number"
        },
        "exceeds_limit": {
          "description": "`true` quando `temp_c` > `active_limit_c`. Sempre `false` sem limite.",
          "type": "boolean"
        },
        "is_monitor": {
          "description": "Sensor apenas de monitoramento, sem limite normativo aplicável.",
          "type": "boolean"
        },
        "key_area": {
          "type": "string"
        },
        "limit_ratio": {
          "description": "`temp_c / active_limit_c`. `null` quando não há limite.",
          "type": [
            "number",
            "null"
          ]
        },
        "monitor_reference_c": {
          "description": "Referência informativa (°C) anotada para sensores de monitoramento.",
          "type": [
            "number",
            "null"
          ]
        },
        "reliability": {
          "$ref": "#/$defs/Reliability"
        },
        "tc_name": {
          "type": "string"
        },
        "tc_number": {
          "type": "number"
        },
        "temp_c": {
          "description": "Temperatura prevista, em °C.",
          "type": "number"
        }
      },
      "required": [
        "tc_number",
        "tc_name",
        "key_area",
        "temp_c",
        "error_margin_c",
        "error_margin_pct",
        "active_limit_c",
        "exceeds_limit",
        "limit_ratio",
        "is_monitor",
        "monitor_reference_c",
        "reliability"
      ],
      "type": "object"
    },
    "StoveConfig": {
      "additionalProperties": false,
      "description": "Configuração do fogão: as 7 colunas categóricas do dataset. Os valores devem ser exatamente as opções canônicas devolvidas por `getMetadata().variables[].options`.",
      "properties": {
        "blower_direction": {
          "description": "Direção em que o blower de resfriamento empurra o ar.",
          "type": "string"
        },
        "board_position": {
          "description": "Posição da placa eletrônica. Ignorada pelo modelo (H2).",
          "type": "string"
        },
        "deflector_hole": {
          "description": "Furo do defletor de ar.",
          "type": "string"
        },
        "housing": {
          "description": "Estado da carcaça da eletrônica.",
          "type": "string"
        },
        "losses": {
          "description": "Perfil de perdas térmicas assumido na simulação. Ignorado pelo modelo (H2).",
          "type": "string"
        },
        "material_coil_support": {
          "description": "Material do suporte da resistência.",
          "type": "string"
        },
        "run_case": {
          "description": "Modo de operação simulado.",
          "type": "string"
        }
      },
      "required": [
        "blower_direction",
        "housing",
        "board_position",
        "run_case",
        "losses",
        "deflector_hole",
        "material_coil_support"
      ],
      "type": "object"
    },
    "VariableMeta": {
      "additionalProperties": false,
      "properties": {
        "help_pt": {
          "type": "string"
        },
        "label_pt": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "used_by_model": {
          "description": "`false` para `losses` e `board_position` (excluídos pela H2).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label_pt",
        "help_pt",
        "options",
        "used_by_model"
      ],
      "type": "object"
    }
  }
}
